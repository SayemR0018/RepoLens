# Required for live analysis. Never commit a real key.
OPENAI_API_KEY=

# Model used for structured JSON output. Defaults to gpt-5.6-luna when unset.
OPENAI_MODEL=gpt-5.6-luna

# Set this for live multi-file fetch. Public repos can be read without it, but a rate limit
# then fails the request and asks for GITHUB_TOKEN.
GITHUB_TOKEN=

# Set to 1 to return the deterministic sample and skip OpenAI.
REPOLENS_MOCK=
