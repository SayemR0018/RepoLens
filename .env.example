# Required for live analysis. Never commit a real key.
OPENAI_API_KEY=

# Model used for structured JSON output. Defaults to gpt-6 when unset.
OPENAI_MODEL=gpt-6

# Optional. Public repositories work without a token. Set one to raise GitHub rate limits.
GITHUB_TOKEN=

# Set to 1 to return the deterministic sample and skip OpenAI.
REPOLENS_MOCK=
